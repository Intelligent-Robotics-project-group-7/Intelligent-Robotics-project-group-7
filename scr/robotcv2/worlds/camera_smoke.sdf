<?xml version="1.0"?>
<sdf version="1.9">
  <world name="camera_smoke">
    <physics name="default" type="ignored">
      <max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <!-- The official robot URDF supplies Sensors. A second instance creates duplicate render scenes. -->
    <gravity>0 0 -9.81</gravity>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.2 0.25 0.3 1</background></scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose><direction>-0.5 0.2 -1</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse><specular>0.1 0.1 0.1 1</specular>
    </light>
    <model name="ground"><static>true</static><pose>0 0 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20 20 0.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>20 20 0.1</size></box></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- A geometric reference target, deliberately not a human model or detector output. -->
    <model name="depth_reference"><static>true</static><pose>3 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 2 2</size></box></geometry>
          <material><ambient>0.9 0.35 0.05 1</ambient><diffuse>0.9 0.35 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
