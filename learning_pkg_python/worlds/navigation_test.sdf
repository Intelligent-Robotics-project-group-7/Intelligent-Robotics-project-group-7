<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.8">
  <!-- 保留 car_world，兼容原 bridge.yaml 的 /world/car_world/clock。 -->
  <world name="car_world">
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- 物理、GUI 插入操作和场景显示所需的系统。 -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- GPU 雷达依赖 Sensors 系统；IMU 使用独立的 Imu 系统。 -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>24 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>24 20</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 沿用原来的机器人模型；本测试包不另外复制机器人和传感器。 -->
    <!-- GZ_SIM_RESOURCE_PATH 必须包含 learning_pkg_python/models。 -->
    <include>
      <uri>model://vehicle_blue</uri>
      <name>vehicle_blue</name>
      <!-- 出生在地图原点，车头朝 +x；位置和地图坐标直接对应。 -->
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- 静态物体：collision 决定碰撞，visual 决定显示和 GPU 雷达可见几何。 -->
    <model name="wall_north">
      <static>true</static>
      <!-- x y z roll pitch yaw；盒子中心放在半个高度处，使底面接地。 -->
      <pose>0 8 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20.2 0.2 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20.2 0.2 3</size></box></geometry>
          <material><ambient>0.65 0.7 0.75 1</ambient><diffuse>0.65 0.7 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 静态物体：collision 决定碰撞，visual 决定显示和 GPU 雷达可见几何。 -->
    <model name="wall_south">
      <static>true</static>
      <!-- x y z roll pitch yaw；盒子中心放在半个高度处，使底面接地。 -->
      <pose>0 -8 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20.2 0.2 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20.2 0.2 3</size></box></geometry>
          <material><ambient>0.65 0.7 0.75 1</ambient><diffuse>0.65 0.7 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 静态物体：collision 决定碰撞，visual 决定显示和 GPU 雷达可见几何。 -->
    <model name="wall_east">
      <static>true</static>
      <!-- x y z roll pitch yaw；盒子中心放在半个高度处，使底面接地。 -->
      <pose>10 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 16.2 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 16.2 3</size></box></geometry>
          <material><ambient>0.65 0.7 0.75 1</ambient><diffuse>0.65 0.7 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 静态物体：collision 决定碰撞，visual 决定显示和 GPU 雷达可见几何。 -->
    <model name="wall_west">
      <static>true</static>
      <!-- x y z roll pitch yaw；盒子中心放在半个高度处，使底面接地。 -->
      <pose>-10 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 16.2 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 16.2 3</size></box></geometry>
          <material><ambient>0.65 0.7 0.75 1</ambient><diffuse>0.65 0.7 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 静态物体：collision 决定碰撞，visual 决定显示和 GPU 雷达可见几何。 -->
    <model name="obstacle_a">
      <static>true</static>
      <!-- x y z roll pitch yaw；盒子中心放在半个高度处，使底面接地。 -->
      <pose>4 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1 3 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 3 2</size></box></geometry>
          <material><ambient>0.9 0.45 0.1 1</ambient><diffuse>0.9 0.45 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 静态物体：collision 决定碰撞，visual 决定显示和 GPU 雷达可见几何。 -->
    <model name="obstacle_b">
      <static>true</static>
      <!-- x y z roll pitch yaw；盒子中心放在半个高度处，使底面接地。 -->
      <pose>-3 4 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2 1 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2 1 2</size></box></geometry>
          <material><ambient>0.9 0.45 0.1 1</ambient><diffuse>0.9 0.45 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
